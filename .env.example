# Copy this file:
#   dev  -> cp .env.prod.example .env.prod.dev   (values below already match dev defaults)
#   prod -> cp .env.prod.example .env.prod       (then change every value marked CHANGE-ME)

POSTGRES_DB=btgpactualdb
DB_URL=jdbc:postgresql://localhost:5432/btgpactualdb
DB_USERNAME=user
DB_PASSWORD=CHANGE-ME-in-prod

# RabbitMQ
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASS=guest

SONAR_HOST_URL=http://localhost:9000
SONAR_TOKEN=CHANGE-ME